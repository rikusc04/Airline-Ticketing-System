# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit it.

# Flask environment: production | development | testing
FLASK_ENV=production

# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-me-with-a-long-random-string

# REQUIRED in production. SQLAlchemy DB URL. Examples:
#   mysql+pymysql://user:pass@localhost:3306/air_ticket_system?charset=utf8mb4
#   mysql+pymysql://user:pass@mysql:3306/air_ticket_system?charset=utf8mb4  (docker-compose)
DATABASE_URL=mysql+pymysql://appuser:REPLACE_ME@mysql:3306/air_ticket_system?charset=utf8mb4

# Optional: log verbosity (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# --- docker-compose only ---
# Root password for the MySQL container (used only during init).
MYSQL_ROOT_PASSWORD=REPLACE_ME_ROOT
# Application DB user + password (must match DATABASE_URL above).
MYSQL_DATABASE=air_ticket_system
MYSQL_USER=appuser
MYSQL_PASSWORD=REPLACE_ME
